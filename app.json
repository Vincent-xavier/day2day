{
  "expo": {
    "name": "Day2Day",
    "slug": "day2day",
    "scheme": "day2day",
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "android": {
      "package": "com.day2day.app"
    },
    "ios": {
      "bundleIdentifier": "com.day2day.app"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0E132A"
    },
    "assetBundlePatterns": ["**/*"],
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Day2Day to access your photos so you can choose a profile image."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ]
  }
}
